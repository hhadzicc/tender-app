<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>opencover,cobertura</Format>
					<Exclude>
						[TenderiApp]TenderiApp.Program*
						[TenderiApp]TenderiApp.Views.*
						[TenderiApp]TenderiApp.Controllers.*
						[TenderiApp.Tests]*
					</Exclude>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
